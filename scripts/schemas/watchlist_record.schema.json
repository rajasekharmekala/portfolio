{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "portfolio/watchlist_record.schema.json",
  "title": "Watchlist record (shared IN + US)",
  "description": "Canonical record for rows of the watchlist 'active' and 'archive' lists. One field set is shared by both markets. The redundant legacy 'strategy_book' field was merged into 'strategy_bucket' during normalization.",
  "type": "object",
  "required": [
    "symbol",
    "company_name",
    "source_type",
    "status",
    "action_verdict",
    "kpi_health",
    "gate_status",
    "strategy_bucket",
    "as_of_date"
  ],
  "properties": {
    "symbol": { "type": "string", "minLength": 1 },
    "company_name": { "type": "string", "minLength": 1 },
    "source_type": { "type": "string", "minLength": 1 },

    "status": { "enum": ["COMPLETED", "RESEARCH_REQUIRED", "REJECTED", "UNDERWRITTEN", "ARCHIVED", "PENDING", "UNKNOWN"] },
    "action_verdict": {
      "enum": ["IMMEDIATE_BUY", "ACCUMULATE_ON_DIP", "KEEP_COMPOUNDING", "WAIT_FOR_SUPPORT", "TRIM_PROFIT_BOOKING", "REPLACE_UNDERPERFORMER", "REJECTED", "QUALIFIED", "PENDING", "RESEARCH_REQUIRED"]
    },
    "action_verdict_detail": { "type": ["string", "null"] },
    "deep_research_status": { "type": ["string", "null"] },
    "research_cycle": { "type": ["integer", "null"], "minimum": 0 },
    "gate_status": { "enum": ["PASSED", "PASSED_CONDITIONAL", "PARTIAL", "FAIL", "PENDING", "UNKNOWN"] },
    "gate_status_detail": { "type": ["string", "null"] },
    "kpi_health": { "enum": ["PASS", "PASS_WITH_WATCH", "FAIL", "PENDING", "UNKNOWN"] },
    "kpi_score": { "type": ["string", "null"], "pattern": "^\\d+/\\d+$" },
    "entry_posture": { "type": ["string", "null"] },
    "strategy_fit": { "type": ["string", "null"] },
    "shortlist_action": { "type": ["string", "null"] },
    "strategy_bucket": {
      "enum": ["CORE_ALPHA", "TACTICAL_MOMENTUM", "LEVERAGED_SATELLITE", "LEAPS_OPTIONS", "REJECTED", "PENDING", "UNKNOWN"]
    },
    "account_scope": { "type": ["string", "null"] },

    "as_of_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$|^unknown$" },
    "stale_as_of": { "type": "boolean" },
    "last_researched_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$|^unknown$" },

    "theme_tags": { "type": ["string", "array", "null"], "items": { "type": "string" } },
    "catalyst_timeline": { "type": ["string", "null"] },
    "investment_thesis": { "type": ["string", "null"] },
    "summary_rationale": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
