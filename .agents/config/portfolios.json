{
  "_comment": "Input sources for the ledger and every report. kind: transactions (an append-only account log; holdings are replayed from it), records (a list of workflow records inside a JSON file; key is a dotted path to the list, symbol_key names the symbol, value_key optionally gives a current value). A missing required source aborts the run. Metadata (strategy bucket, name) comes from data/metadata/symbols.json.",
  "IN": {
    "currency": "INR",
    "sources": [
      {"id": "zerodha", "role": "holding", "kind": "transactions", "path": "data/accounts/IN/zerodha.transactions.jsonl"},
      {"id": "watchlist_active", "role": "watchlist", "kind": "records", "path": "data/watchlist/IN.json", "key": "active", "symbol_key": "symbol"},
      {"id": "shortlist", "role": "shortlist", "kind": "records", "path": "data/shortlist/IN.json", "key": "sheets.Master_Shortlist", "symbol_key": "symbol"},
      {"id": "options_book", "role": "options", "kind": "records", "path": "data/options/IN.json", "key": "positions", "symbol_key": "ticker"}
    ]
  },
  "US": {
    "currency": "USD",
    "sources": [
      {"id": "schwab", "role": "holding", "kind": "transactions", "path": "data/accounts/US/schwab.transactions.jsonl"},
      {"id": "robinhood", "role": "holding", "kind": "transactions", "path": "data/accounts/US/robinhood.transactions.jsonl"},
      {"id": "watchlist_active", "role": "watchlist", "kind": "records", "path": "data/watchlist/US.json", "key": "active", "symbol_key": "symbol"},
      {"id": "shortlist", "role": "shortlist", "kind": "records", "path": "data/shortlist/US.json", "key": "sheets.Master_Shortlist", "symbol_key": "symbol"},
      {"id": "options_book", "role": "options", "kind": "records", "path": "data/options/US.json", "key": "positions", "symbol_key": "underlying", "value_key": "current_mv_usd"}
    ]
  }
}
