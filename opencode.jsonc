{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "portfolio",
  "mcp": {
    "servers": {
      "duck-duck-go": {
        "type": "local",
        "command": ["uvx", "duckduckgo-mcp-server"]
      }
    }
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" }

  ],
  "agents": {
    "portfolio": {
      "description": "Portfolio report runs. The report skills require the duck-duck-go research pass.",
      "mode": "primary",
      "model": "azure/claude-haiku-5-5#high"
    }
  }
}
